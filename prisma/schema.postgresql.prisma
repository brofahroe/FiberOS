generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  clusters    Cluster[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cluster {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  homePasses   Int           @default(0)
  workItems    WorkItem[]
  dailyReports DailyReport[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, name])
}

model WorkItem {
  id           String              @id @default(cuid())
  clusterId    String
  cluster      Cluster             @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  category     String              // POLE, CABLE, FAT, FDT, ACCESSORY, OTHER
  itemName     String
  unit         String              @default("pcs")
  boq          Float               @default(0)
  status       String              @default("ONGOING") // ONGOING, DONE, HOLD
  sortOrder    Int                 @default(0)
  progressList DailyProgressItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([clusterId, itemName])
}

model DailyReport {
  id           String              @id @default(cuid())
  clusterId    String
  cluster      Cluster             @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  reportDate   String
  reporterName String?
  teamName     String?
  weather      String?
  notes        String?
  photos       String?
  items        DailyProgressItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([clusterId, reportDate])
}

model DailyProgressItem {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  workItemId    String
  workItem      WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  quantity      Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([dailyReportId, workItemId])
}

